<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====== Superfici ====== -->
    <SolidColorBrush x:Key="BgFinestra" Color="#FF171A22"/>
    <SolidColorBrush x:Key="BgCard" Color="#FF232834"/>
    <SolidColorBrush x:Key="BgCardHover" Color="#FF2D3340"/>
    <SolidColorBrush x:Key="BgInput" Color="#FF12141B"/>

    <!-- ====== Testo ====== -->
    <SolidColorBrush x:Key="TestoPrincipale" Color="#FFF2F4F8"/>
    <SolidColorBrush x:Key="TestoSecondario" Color="#FF99A3B3"/>
    <SolidColorBrush x:Key="TestoSecondarioOnLight" Color="#FF6B7280"/>

    <!-- ====== Accenti ====== -->
    <SolidColorBrush x:Key="BgAppBar" Color="#FF2563EB"/>
    <SolidColorBrush x:Key="ColorePrimario" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="ColorePrimarioScuro" Color="#FF2563EB"/>
    <SolidColorBrush x:Key="ColoreSecondario" Color="#FF5B6677"/>
    <SolidColorBrush x:Key="ColorePrimarioAlpha" Color="#283B82F6"/>

    <LinearGradientBrush x:Key="GradientePrimario" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF4C8DFF" Offset="0"/>
        <GradientStop Color="#FF2F6FE6" Offset="1"/>
    </LinearGradientBrush>

    <!-- ====== Selezione / bordi ====== -->
    <SolidColorBrush x:Key="ColoreSelezione" Color="#FF21385A"/>
    <SolidColorBrush x:Key="ColoreBordoCard" Color="#FF363D4E"/>

    <!-- ====== Stati / semantica ====== -->
    <SolidColorBrush x:Key="ColoreIngressi" Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="ColoreUscite" Color="#FFFBBF24"/>
    <SolidColorBrush x:Key="ColoreAllarme" Color="#FFF87171"/>

    <!-- ====== Ombre ====== -->
    <DropShadowEffect x:Key="OmbraCard" Color="Black" Opacity="0.35" BlurRadius="16" ShadowDepth="3" Direction="270"/>
    <DropShadowEffect x:Key="OmbraPopUp" Color="Black" Opacity="0.60" BlurRadius="30" ShadowDepth="6" Direction="270"/>

    <!-- ====== Pulsanti ====== -->
    <SolidColorBrush x:Key="BgPulsante" Color="#FF323A4B"/>
    <SolidColorBrush x:Key="BordoPulsante" Color="#FF49526A"/>
    <SolidColorBrush x:Key="BgPulsantePressed" Color="#FF232834"/>
</ResourceDictionary>
